# Safe to expose to the browser. The anon key is limited by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=

# Set to static to publish the bundled content before Supabase is connected.
# Supabase takes priority once its URL and key are set.
VITE_CONTENT_SOURCE=

# Server only. Set these as Edge Function secrets. Never prefix them with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# CONTACT_IP_HASH_SALT=
